NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sovastro
JWT_SECRET=change_this_to_a_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
# Comma separated, exact origins of the frontend
FRONTEND_URL=http://localhost:5173
TZ_NAME=Asia/Kolkata
# Only when frontend & backend are on different sites in production
COOKIE_SAMESITE=none
