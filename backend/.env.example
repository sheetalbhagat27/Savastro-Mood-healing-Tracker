# ===================================================
# Savastro Backend Environment Configuration (.env)
# ===================================================

# Server Port
PORT=5000
NODE_ENV=development

# Allowed Frontend URL (for CORS and email verification links)
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/savastro?retryWrites=true&w=majority
MONGO_URI=

# JWT Authentication Secret & Expiration
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Email Verification & Login Alert Flags
EMAIL_VERIFICATION_REQUIRED=false
SEND_LOGIN_NOTIFICATION=true

# SMTP Email Configuration (Nodemailer)
# (Leave empty in local dev to simulate email dispatch in console logs)
EMAIL_FROM=Savastro <no-reply@savastro.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
